rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /pdf/{declarationId}/{filename} {
   allow read: if request.auth != null && (firestore.get(/databases/(default)/documents/declarations/$(declarationId)).data.ownerId == request.auth.uid || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['rrhh','admin']);
   allow write: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['rrhh','admin'] && firestore.get(/databases/(default)/documents/declarations/$(declarationId)).data.status == 'FINALIZADA' && request.resource.contentType == 'application/pdf' && request.resource.size < 10485760;
  }
 }
}
