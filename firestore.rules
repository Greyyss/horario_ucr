// ADMIN_SCOPE_ONLY
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/pendingAppointments/{appointmentId} {
      allow read: if signed() && request.auth.uid == uid;
      allow write: if false;
    }


    function validName(value) {
  let letters =
    "A-Za-zÁÉÍÓÚÜÑáéíóúüñÀÈÌÒÙàèìòùÂÊÎÔÛâêîôûÄËÏÖäëïöÇç";

  return value is string
    && value.size() >= 5
    && value.size() <= 100
    && value.matches(
      "[" + letters + "]+([-’'][" + letters + "]+)*"
      + "( [" + letters + "]+([-’'][" + letters + "]+)*)+"
    );
}

function validIdentification(value) {
  return value is string
    && value.matches('[0-9]{9}');
}

function validPhone(value) {
  return value is string
    && value.matches('[0-9]{8}');
}

function validEmail(value) {
  return value is string
    && value.size() <= 254
    && value.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+');
}

function validUnit(value) {
  return value is string
    && value.size() >= 2
    && value.size() <= 150
    && value.matches('\\S([^\\r\\n\\t]*\\S)?');
}

function validPersonalData(data) {
  return validName(data.get('ownerName', null))
    && validIdentification(data.get('identification', null))
    && validPhone(data.get('phone', null))
    && validEmail(data.get('email', null))
    && validUnit(data.get('unit', null))
    && data.get('observations', null) is string
    && data.observations.size() <= 2000;
}

function validInitialProfile(data) {
  return validName(data.get('name', null))
    && validEmail(data.get('email', null))
    && (
      data.get('identification', null) == ''
      || validIdentification(data.get('identification', null))
    )
    && (
      data.get('phone', null) == ''
      || validPhone(data.get('phone', null))
    )
    && (
      data.get('unit', null) == ''
      || validUnit(data.get('unit', null))
    );
}

// La cédula solo puede pasar de vacía/ausente a un valor válido.
// Una vez registrada, ningún cliente puede cambiarla, borrarla o eliminarla.
function identificationUnchangedOrFirstSet() {
  let previous = resource.data.get('identification', '');
  let next = request.resource.data.get('identification', null);
  return (previous == '' && (next == '' || validIdentification(next)))
    || (previous != '' && next == previous);
}

function validProfileChanges() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  let data = request.resource.data;
  return identificationUnchangedOrFirstSet()
    && (!changed.hasAny(['name']) || validName(data.get('name', null)))
    && (!changed.hasAny(['email']) || validEmail(data.get('email', null)))
    && (!changed.hasAny(['phone']) || validPhone(data.get('phone', null)))
    && (!changed.hasAny(['unit']) || validUnit(data.get('unit', null)));
}

    // FUNCIONES DE SEGURIDAD
    function accountCanUseApp() {
      let path =
        /databases/$(database)/documents/users/$(request.auth.uid);

      return !exists(path) || (
        get(path).data.get('role', '') != 'eliminando'
        && (
          get(path).data.get('accessPolicy', null) == null
          || (
            get(path).data.get('accessPolicy', null) == 1
            && get(path).data.get('accessState', '') == 'active'
          )
        )
      );
    }

    function signed() {
      return request.auth != null && accountCanUseApp();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signed() ? userDoc().data.role : 'none';
    }

    function staff() {
      return role() in ['admin', 'rrhh'];
    }

    function owner(d) {
      return signed() && d.ownerId == request.auth.uid;
    }

       function superior(d) {
      return signed()
        && d.superiorId == request.auth.uid
        && role() == 'superior';
    }

    function canRead(d) {
      return signed()
        && role() != 'admin'
        && (owner(d) || superior(d) || role() == 'rrhh');
    }

    function declarationAfter(id) {
      return getAfter(/databases/$(database)/documents/declarations/$(id)).data;
    }

    function declarationBefore(id) {
      return get(/databases/$(database)/documents/declarations/$(id)).data;
    }

    
    function validTransitionEvent(id) {
      let before = declarationBefore(id);
      let after = declarationAfter(id);
      let event = request.resource.data.event;

      return request.resource.data.previousStatus == before.status
        && request.resource.data.newStatus == after.status
        && request.resource.data.version == after.version
        && (
          (
            owner(before)
            && (
              (
                event == 'validate'
                && before.status == 'BORRADOR'
                && after.status == 'VALIDADA'
              )
              || (
                event == 'submit'
                && before.status == 'VALIDADA'
                && after.status == 'PENDIENTE_FIRMA_DECLARANTE'
              )
              || (
                event == 'signOwner'
                && before.status == 'PENDIENTE_FIRMA_DECLARANTE'
                && after.status == 'FIRMADA_POR_DECLARANTE'
              )
              || (
                event == 'route'
                && before.status == 'FIRMADA_POR_DECLARANTE'
                && after.status == 'PENDIENTE_FIRMA_SUPERIOR'
              )
              || (
                event == 'newVersion'
                && before.status == 'DEVUELTA'
                && after.status == 'BORRADOR'
                && after.version == before.version + 1
              )
              || (
                event == 'annul'
                && before.status in ['BORRADOR', 'VALIDADA']
                && after.status == 'ANULADA'
              )
            )
          )
          || (
            superior(before)
            && (
              (
                event == 'signSuperior'
                && before.status == 'PENDIENTE_FIRMA_SUPERIOR'
                && after.status == 'FIRMADA_POR_SUPERIOR'
              )
              || (
                event == 'return'
                && before.status == 'PENDIENTE_FIRMA_SUPERIOR'
                && after.status == 'DEVUELTA'
                && after.returnNote is string
                && after.returnNote.size() > 0
              )
              || (
                event == 'sendHr'
                && before.status == 'FIRMADA_POR_SUPERIOR'
                && after.status == 'ENVIADA_A_RRHH'
              )
            )
          )
          || (
            role() == 'rrhh'
            && (
              (
                event == 'receive'
                && before.status == 'ENVIADA_A_RRHH'
                && after.status == 'RECIBIDA_RRHH'
              )
              || (
                event == 'finish'
                && before.status == 'RECIBIDA_RRHH'
                && after.status == 'FINALIZADA'
              )
            )
          )
        );
    }


    // USUARIOS
    match /users/{uid} {
      // El perfil completo solo está disponible para su dueño y para
      // administración/RRHH, que ya intervenían en el flujo del proyecto.
      // Un superior no obtiene acceso general a los perfiles.
      // El perfil propio se puede consultar antes de activar.
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || (signed() && staff())
        );

      allow create: if false;

                 allow update: if signed()
        && (
          (
            // La persona edita sus propios datos.
            request.auth.uid == uid
            && validProfileChanges()
            && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'name',
                  'email',
                  'unit',
                  'identification',
                  'phone'
                ])
            && (
              resource.data.get('identitySource', '') != 'padron'
              || !request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasAny(['name', 'identification'])
            )
          )
          || (
            // Administración cambia solamente el rol de una cuenta ajena.
            role() == 'admin'
            && request.auth.uid != uid
            && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly(['role'])
            && request.resource.data.role in [
              'declarante',
              'superior',
              'rrhh',
              'admin'
            ]
          )
        );
      // Impide eliminar y recrear un perfil para reemplazar la cédula.
      // Bajas y correcciones excepcionales requieren un proceso de servidor.
      allow delete: if false;
    }

    // NOTIFICACIONES
    match /users/{uid}/notifications/{notificationId} {
      // Cada usuario puede consultar únicamente su bandeja.
      allow read: if signed() && request.auth.uid == uid;

      // La creación y los cambios de lectura los realiza el backend.
      allow write: if false;
    }

    // PERIODOS ACADEMICOS
    match /periods/{id} {
      allow read: if signed();
      allow write: if role() == 'admin';
    }

    // DECLARACIONES
    match /declarations/{id} {
      function finalDigitalPdf() {
        let v = resource.data.version;
        let a = get(/databases/$(database)/documents/declarations/$(id)/versions/$(v)/artifacts/finalPdf).data;
        let key = id + '--v' + string(v);
        let w = get(/databases/$(database)/documents/_signatureWorkflows/$(key)).data;

        return a.method == 'DIGITAL_PDF'
          && a.version == v
          && w.version == v
          && w.ownerId == resource.data.ownerId
          && w.superiorId == resource.data.superiorId
          && w.superior.sha256 == a.sha256;
      }

      allow read: if signed()
        && role() != 'admin'
        && canRead(resource.data);

      allow create, delete: if false;

      allow update: if signed()
        && role() != 'admin'
        && request.resource.data.version == resource.data.version
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'returnNote'])
        && (
          (
            owner(resource.data)
            && (
              (
                resource.data.status == 'VALIDADA'
                && request.resource.data.status == 'PENDIENTE_FIRMA_DECLARANTE'
              )
              || (
                resource.data.status in ['BORRADOR', 'VALIDADA']
                && request.resource.data.status == 'ANULADA'
              )
            )
          )
          || (
            superior(resource.data)
            && resource.data.status == 'PENDIENTE_FIRMA_SUPERIOR'
            && request.resource.data.status == 'DEVUELTA'
            && request.resource.data.returnNote is string
            && request.resource.data.returnNote.size() > 0
          )
          || (
            role() == 'rrhh'
            && (
              (
                resource.data.status == 'ENVIADA_A_RRHH'
                && request.resource.data.status == 'RECIBIDA_RRHH'
              )
              || (
                resource.data.status == 'RECIBIDA_RRHH'
                && request.resource.data.status == 'FINALIZADA'
              )
            )
            && finalDigitalPdf()
          )
        );

      match /versions/{version} {
        allow read: if signed()
          && role() != 'admin'
          && canRead(declarationBefore(id));

        allow write: if false;

        match /artifacts/{artifactId} {
          allow read: if signed()
            && role() != 'admin'
            && artifactId == 'finalPdf'
            && canRead(declarationBefore(id));

          allow write: if false;
        }

        match /signatures/{signatureId} {
          allow read: if signed()
            && role() != 'admin'
            && canRead(declarationBefore(id));

          allow write: if false;
        }
      }

      match /events/{eventId} {
        allow read: if signed()
          && role() != 'admin'
          && canRead(declarationBefore(id));

        allow create: if signed()
          && role() != 'admin'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.event in [
            'submit', 'annul', 'return', 'receive', 'finish'
          ]
          && validTransitionEvent(id);

        allow update, delete: if false;
      }
    }
  }
}